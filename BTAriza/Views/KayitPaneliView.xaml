<UserControl x:Class="BTAriza.Views.KayitPaneliView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#151C27" FontFamily="Segoe UI">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="Kayıt Paneli" FontSize="22" FontWeight="Bold"
                       Foreground="#ECEFF4" VerticalAlignment="Center"/>
            <TextBlock x:Name="ToplamKayitText" Foreground="#8899AA" FontSize="13"
                       VerticalAlignment="Center" Margin="15,0,0,0"/>
        </StackPanel>

        <!-- Filtreler -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="15,12" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TxtArama" Grid.Column="0"
                         Style="{StaticResource DarkTextBoxStyle}"
                         PlaceholderText="&#xE721;  Arama..."
                         TextChanged="Filtrele"/>

                <ComboBox x:Name="CmbDurumFiltre" Grid.Column="2"
                          Style="{StaticResource DarkComboBoxStyle}"
                          SelectionChanged="Filtrele">
                    <ComboBoxItem Content="Tüm Durumlar" IsSelected="True"/>
                    <ComboBoxItem Content="Bekliyor"/>
                    <ComboBoxItem Content="İşlemde"/>
                    <ComboBoxItem Content="Çözüldü"/>
                </ComboBox>

                <ComboBox x:Name="CmbOncelikFiltre" Grid.Column="4"
                          Style="{StaticResource DarkComboBoxStyle}"
                          SelectionChanged="Filtrele">
                    <ComboBoxItem Content="Tüm Öncelikler" IsSelected="True"/>
                    <ComboBoxItem Content="Düşük"/>
                    <ComboBoxItem Content="Orta"/>
                    <ComboBoxItem Content="Yüksek"/>
                    <ComboBoxItem Content="Kritik"/>
                </ComboBox>

                <ComboBox x:Name="CmbDepartmanFiltre" Grid.Column="6"
                          Style="{StaticResource DarkComboBoxStyle}"
                          SelectionChanged="Filtrele">
                    <ComboBoxItem Content="Tüm Departmanlar" IsSelected="True"/>
                    <ComboBoxItem Content="IT"/>
                    <ComboBoxItem Content="Muhasebe"/>
                    <ComboBoxItem Content="İK"/>
                    <ComboBoxItem Content="Satış"/>
                    <ComboBoxItem Content="Yönetim"/>
                    <ComboBoxItem Content="Diğer"/>
                </ComboBox>

                <Button Grid.Column="8" Content="CSV Export"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="CsvExport_Click" Padding="12,8"/>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <!-- Boş state -->
                <StackPanel x:Name="BosPanel" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets"
                               FontSize="48" Foreground="#2A3A4A" HorizontalAlignment="Center"/>
                    <TextBlock Text="Henüz kayıt yok" Foreground="#8899AA"
                               FontSize="16" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>

                <DataGrid x:Name="KayitGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          MouseDoubleClick="KayitGrid_DoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Arıza No" Binding="{Binding ArizaNo}" Width="90"/>
                        <DataGridTextColumn Header="Ad Soyad" Binding="{Binding AdSoyad}" Width="*"/>
                        <DataGridTextColumn Header="Departman" Binding="{Binding Departman}" Width="100"/>
                        <DataGridTextColumn Header="Kategori" Binding="{Binding Kategori}" Width="130"/>
                        <DataGridTemplateColumn Header="Öncelik" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="6,2" Margin="2"
                                            Background="{Binding Oncelik, Converter={StaticResource OncelikRenkConverter}}"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Oncelik, Converter={StaticResource OncelikStringConverter}}"
                                                   Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="İletilen" Binding="{Binding IletilenKisiDisplay}" Width="80"/>
                        <DataGridTemplateColumn Header="Durum" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="6,2" Margin="2"
                                            Background="{Binding Durum, Converter={StaticResource DurumRenkConverter}}"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Durum, Converter={StaticResource DurumStringConverter}}"
                                                   Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Tarih"
                                            Binding="{Binding OlusturmaTarihi, StringFormat=dd.MM.yyyy HH:mm}"
                                            Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
