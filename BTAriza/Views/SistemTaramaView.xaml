<UserControl x:Class="BTAriza.Views.SistemTaramaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#151C27" FontFamily="Segoe UI">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Başlık + Buton -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="Sistem Tarama" FontSize="22" FontWeight="Bold"
                       Foreground="#ECEFF4" VerticalAlignment="Center"/>
            <Button x:Name="BtnTara" Content="&#xE721;  Taramayı Başlat"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="20,0,0,0" Click="Tara_Click"
                    FontFamily="Segoe MDL2 Assets, Segoe UI"/>
            <Button x:Name="BtnPdf" Content="&#xE7C3;  PDF Rapor Al"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="12,0,0,0" Click="PdfRapor_Click"
                    Visibility="Collapsed"
                    FontFamily="Segoe MDL2 Assets, Segoe UI"/>
        </StackPanel>

        <!-- Tarama Durumu -->
        <Border Grid.Row="1" x:Name="TaramaDurumuPanel"
                Style="{StaticResource CardStyle}" Margin="0,0,0,15"
                Visibility="Collapsed">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,10">
                    <TextBlock x:Name="TaramaMesaji" Text="Taranıyor..."
                               Foreground="#E87B3A" FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>
                <ProgressBar x:Name="TaramaProgress" Height="6" IsIndeterminate="True"
                             Background="#2A3A4A" Foreground="#E87B3A" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- Sonuçlar -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SonuclarPanel" Visibility="Collapsed">

                <!-- İşlemci + GPU -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="20" Foreground="#E87B3A"/>
                                <TextBlock Text="İşlemci" FontSize="15" FontWeight="SemiBold"
                                           Foreground="#ECEFF4"/>
                            </StackPanel>
                            <TextBlock x:Name="CpuBilgiText" Foreground="#B0C0D0"
                                       FontSize="13" TextWrapping="Wrap" LineHeight="22"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="20" Foreground="#9B59B6"/>
                                <TextBlock Text="GPU" FontSize="15" FontWeight="SemiBold"
                                           Foreground="#ECEFF4"/>
                            </StackPanel>
                            <TextBlock x:Name="GpuBilgiText" Foreground="#B0C0D0"
                                       FontSize="13" TextWrapping="Wrap" LineHeight="22"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- RAM -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,15">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
                            <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="20" Foreground="#3498DB"/>
                            <TextBlock Text="Bellek (RAM)" FontSize="15" FontWeight="SemiBold"
                                       Foreground="#ECEFF4"/>
                        </StackPanel>
                        <TextBlock x:Name="RamBilgiText" Foreground="#B0C0D0" FontSize="13" Margin="0,0,0,10"/>
                        <ProgressBar x:Name="RamProgressBar" Height="10"
                                     Background="#2A3A4A" Foreground="#3498DB" BorderThickness="0" Maximum="100"/>
                    </StackPanel>
                </Border>

                <!-- Disk -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,15">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
                            <TextBlock Text="&#xEDA2;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="20" Foreground="#27AE60"/>
                            <TextBlock Text="Diskler" FontSize="15" FontWeight="SemiBold"
                                       Foreground="#ECEFF4"/>
                        </StackPanel>
                        <ItemsControl x:Name="DiskListesi">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding}" Foreground="#B0C0D0" FontSize="13"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Ağ + Windows/Antivirüs -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
                                <TextBlock Text="&#xE909;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="20" Foreground="#1A73E8"/>
                                <TextBlock Text="Ağ Bağdaştırıcıları" FontSize="15" FontWeight="SemiBold"
                                           Foreground="#ECEFF4"/>
                            </StackPanel>
                            <ItemsControl x:Name="AgListesi">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="#B0C0D0"
                                                   FontSize="12" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
                                <TextBlock Text="&#xE782;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="20" Foreground="#1A73E8"/>
                                <TextBlock Text="Windows / Antivirüs" FontSize="15" FontWeight="SemiBold"
                                           Foreground="#ECEFF4"/>
                            </StackPanel>
                            <TextBlock x:Name="WindowsBilgiText" Foreground="#B0C0D0"
                                       FontSize="13" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,12"/>
                            <Rectangle Height="1" Fill="#2A3A4A" Margin="0,0,0,12"/>
                            <TextBlock x:Name="AntivirusText" Foreground="#B0C0D0"
                                       FontSize="13" TextWrapping="Wrap" LineHeight="22"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Boş başlangıç durumu -->
        <StackPanel x:Name="BaslangicPanel" Grid.Row="2"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets"
                       FontSize="64" Foreground="#2A3A4A" HorizontalAlignment="Center"/>
            <TextBlock Text="Sistem bilgilerini görüntülemek için taramayı başlatın"
                       Foreground="#8899AA" FontSize="14" HorizontalAlignment="Center" Margin="0,12,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
