<UserControl x:Class="BTAriza.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#151C27" FontFamily="Segoe UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="25">
            <!-- Başlık -->
            <TextBlock Text="Genel Bakış" FontSize="22" FontWeight="Bold"
                       Foreground="#ECEFF4" Margin="0,0,0,20"/>

            <!-- İstatistik Kartları -->
            <Grid Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Bekleyen -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Cursor="Hand">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding BekliyenCommand}"/>
                    </Border.InputBindings>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Background="#3D2A00" CornerRadius="8" Padding="10">
                                <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="20" Foreground="#F39C12"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="BekliyenSayi" Text="0"
                                   FontSize="36" FontWeight="Bold" Foreground="#F39C12"/>
                        <TextBlock Text="Bekleyen Arıza" FontSize="13" Foreground="#8899AA" Margin="0,4,0,0"/>
                        <Rectangle Height="3" Fill="#F39C12" Margin="0,12,0,0" RadiusX="2" RadiusY="2"/>
                    </StackPanel>
                </Border>

                <!-- İşlemde -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Cursor="Hand">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Background="#001D3D" CornerRadius="8" Padding="10">
                                <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="20" Foreground="#3498DB"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="IslemdeSayi" Text="0"
                                   FontSize="36" FontWeight="Bold" Foreground="#3498DB"/>
                        <TextBlock Text="İşlemdeki Arıza" FontSize="13" Foreground="#8899AA" Margin="0,4,0,0"/>
                        <Rectangle Height="3" Fill="#3498DB" Margin="0,12,0,0" RadiusX="2" RadiusY="2"/>
                    </StackPanel>
                </Border>

                <!-- Çözülen -->
                <Border Grid.Column="4" Style="{StaticResource CardStyle}" Cursor="Hand">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Background="#003320" CornerRadius="8" Padding="10">
                                <TextBlock Text="&#xE930;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="20" Foreground="#27AE60"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="CozulenSayi" Text="0"
                                   FontSize="36" FontWeight="Bold" Foreground="#27AE60"/>
                        <TextBlock Text="Çözülen Arıza" FontSize="13" Foreground="#8899AA" Margin="0,4,0,0"/>
                        <Rectangle Height="3" Fill="#27AE60" Margin="0,12,0,0" RadiusX="2" RadiusY="2"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Alt Satır: Son Arızalar + Sistem -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- Son Kayıtlar -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="Son Arıza Kayıtları" FontSize="15" FontWeight="SemiBold"
                                       Foreground="#ECEFF4"/>
                            <TextBlock x:Name="SonKayitlarBos" Text="Henüz kayıt yok"
                                       FontSize="13" Foreground="#8899AA"
                                       Margin="15,0,0,0" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </StackPanel>

                        <DataGrid x:Name="SonKayitlarGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  MaxHeight="250"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Arıza No" Binding="{Binding ArizaNo}" Width="90"/>
                                <DataGridTextColumn Header="Ad Soyad" Binding="{Binding AdSoyad}" Width="*"/>
                                <DataGridTextColumn Header="Kategori" Binding="{Binding Kategori}" Width="120"/>
                                <DataGridTemplateColumn Header="Öncelik" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="6,2"
                                                    Background="{Binding Oncelik, Converter={StaticResource OncelikRenkConverter}}"
                                                    HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Oncelik, Converter={StaticResource OncelikStringConverter}}"
                                                           Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Durum" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="6,2"
                                                    Background="{Binding Durum, Converter={StaticResource DurumRenkConverter}}"
                                                    HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Durum, Converter={StaticResource DurumStringConverter}}"
                                                           Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Sistem Durumu -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Sistem Durumu" FontSize="15" FontWeight="SemiBold"
                                   Foreground="#ECEFF4" Margin="0,0,0,20"/>

                        <!-- CPU -->
                        <TextBlock Text="CPU Kullanımı" FontSize="12" Foreground="#8899AA" Margin="0,0,0,6"/>
                        <ProgressBar x:Name="CpuBar" Value="0" Maximum="100"
                                     Height="8" Background="#2A3A4A"
                                     Foreground="#E87B3A" BorderThickness="0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,16">
                            <TextBlock x:Name="CpuText" Text="0%" FontSize="13"
                                       FontWeight="SemiBold" Foreground="#E87B3A"/>
                            <TextBlock Text=" kullanımda" FontSize="12" Foreground="#8899AA"/>
                        </StackPanel>

                        <!-- RAM -->
                        <TextBlock Text="RAM Kullanımı" FontSize="12" Foreground="#8899AA" Margin="0,0,0,6"/>
                        <ProgressBar x:Name="RamBar" Value="0" Maximum="100"
                                     Height="8" Background="#2A3A4A"
                                     Foreground="#3498DB" BorderThickness="0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,16">
                            <TextBlock x:Name="RamText" Text="0%" FontSize="13"
                                       FontWeight="SemiBold" Foreground="#3498DB"/>
                            <TextBlock Text=" kullanımda" FontSize="12" Foreground="#8899AA"/>
                        </StackPanel>

                        <!-- Bilgisayar -->
                        <Rectangle Height="1" Fill="#2A3A4A" Margin="0,4,0,16"/>
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets"
                                           Foreground="#8899AA" VerticalAlignment="Center"/>
                                <TextBlock x:Name="HostnameText" Foreground="#ECEFF4" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="&#xE770;" FontFamily="Segoe MDL2 Assets"
                                           Foreground="#8899AA" VerticalAlignment="Center"/>
                                <TextBlock x:Name="OsText" Foreground="#ECEFF4" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
