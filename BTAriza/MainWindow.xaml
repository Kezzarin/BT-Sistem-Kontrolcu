<Window x:Class="BTAriza.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BT Arıza Takip" Height="750" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#151C27"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetName="ContentArea"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.3"/>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="#1E2A3A">
            <DockPanel>
                <!-- Logo / Şirket Adı -->
                <Border DockPanel.Dock="Top" Padding="20,20,20,10">
                    <StackPanel>
                        <Image x:Name="LogoImage" Height="40" HorizontalAlignment="Left"
                               Visibility="Collapsed" Margin="0,0,0,8"/>
                        <TextBlock x:Name="SirketAdiText"
                                   Text="BT Arıza Takip"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="#E87B3A"/>
                        <TextBlock Text="Yönetim Sistemi"
                                   FontSize="11" Foreground="#8899AA"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Ayırıcı -->
                <Rectangle DockPanel.Dock="Top" Height="1" Fill="#2A3A4A" Margin="15,0"/>

                <!-- Menü Butonları -->
                <StackPanel DockPanel.Dock="Top" Margin="0,10,0,0">
                    <Button x:Name="BtnDashboard" Style="{StaticResource SidebarButtonActiveStyle}"
                            Click="NavButton_Click" Tag="Dashboard">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnArizaRehberi" Style="{StaticResource SidebarButtonStyle}"
                            Click="NavButton_Click" Tag="ArizaRehberi">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Arıza Rehberi" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnSistemTarama" Style="{StaticResource SidebarButtonStyle}"
                            Click="NavButton_Click" Tag="SistemTarama">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Sistem Tarama" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnSurucuYonetimi" Style="{StaticResource SidebarButtonStyle}"
                            Click="NavButton_Click" Tag="SurucuYonetimi">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Sürücü Yönetimi" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnArizaKaydi" Style="{StaticResource SidebarButtonStyle}"
                            Click="NavButton_Click" Tag="ArizaKaydi">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Arıza Kaydı" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnKayitPaneli" Style="{StaticResource SidebarButtonStyle}"
                            Click="NavButton_Click" Tag="KayitPaneli">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Kayıt Paneli" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnAyarlar" Style="{StaticResource SidebarButtonStyle}"
                            Click="NavButton_Click" Tag="Ayarlar">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Ayarlar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Versiyon -->
                <TextBlock DockPanel.Dock="Bottom" Text="v1.0.0 — BTAriza"
                           Foreground="#445566" FontSize="11"
                           Margin="20,0,0,15" VerticalAlignment="Bottom"/>
            </DockPanel>
        </Border>

        <!-- SAĞ PANEL -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ÜST BAR -->
            <Border Grid.Row="0" Background="#1A2535"
                    BorderBrush="#2A3A4A" BorderThickness="0,0,0,1">
                <Grid Margin="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="SayfaBasligiText" Text="Dashboard"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="#ECEFF4"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Spacing="20">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets"
                                       Foreground="#8899AA" VerticalAlignment="Center"/>
                            <TextBlock x:Name="BilgisayarAdiText"
                                       Foreground="#8899AA" FontSize="13"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets"
                                       Foreground="#8899AA" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SaatText"
                                       Foreground="#ECEFF4" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- İÇERİK ALANI -->
            <Border Grid.Row="1" x:Name="ContentArea" Opacity="1">
                <ContentControl x:Name="MainContent" Background="#151C27"/>
            </Border>
        </Grid>
    </Grid>
</Window>
